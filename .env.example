# Copy to .env and adjust for local development.
# Server port (default: 8000)
PORT=8000

# Admin dashboard password. REQUIRED in production - the app refuses to start
# with a weak default. If unset locally, a temporary password is generated and
# printed to the server console.
ADMIN_PASSWORD=replace-with-a-strong-secret

# Used to sign admin session cookies. Defaults to ADMIN_PASSWORD when unset.
SESSION_SECRET=replace-with-a-long-random-string

# PostgreSQL connection string. REQUIRED when NODE_ENV=production
# (the app refuses to fall back to SQLite in production).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional: cap the Postgres connection pool (default 10). Lower it for small free-tier plans.
# PGPOOL_MAX=5
# Set PGSSLMODE=disable only for a local Postgres that does not use SSL.
# PGSSLMODE=disable
